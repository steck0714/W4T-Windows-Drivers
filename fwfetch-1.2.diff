+
+fn spawn_err(e: io::Error) -> String {
+    if e.kind() == io::ErrorKind::NotFound {
+        "curl was not found (Windows 10 1803 and later ship curl.exe in System32; otherwise install curl, or pass the files with --archive)".into()
+    } else {
